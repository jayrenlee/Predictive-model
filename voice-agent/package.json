{
  "name": "viox-banking-voice-agent",
  "version": "0.1.0",
  "description": "Self-hosted banking voice agent — Phase 1 foundation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "ingest": "ts-node src/rag/ingest.ts",
    "db:reset": "docker compose down -v && docker compose up -d && sleep 5 && echo 'DB reset complete'",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test:api": "ts-node scripts/test-api.ts",
    "chat": "ts-node src/chat-loop.ts",
    "chat:mock": "MOCK_AI=true ts-node src/chat-loop.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.0",
    "@langchain/langgraph": "^1.4.4",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-fetch": "^3.3.2",
    "pg": "^8.11.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
