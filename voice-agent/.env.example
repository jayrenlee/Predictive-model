# Database (matches docker-compose.yml defaults)
POSTGRES_USER=viox
POSTGRES_PASSWORD=voiceagent
POSTGRES_DB=banking
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API server
PORT=3000

# GPU box endpoints (Phase 2 — not needed for Phase 1)
# WHISPER_URL=http://<gpu-box-ip>:8001/transcribe
# OLLAMA_URL=http://<gpu-box-ip>:11434
# TTS_URL=http://<gpu-box-ip>:8002/synthesize

# OTP settings
OTP_EXPIRY_SECONDS=120
OTP_MAX_ATTEMPTS=3
