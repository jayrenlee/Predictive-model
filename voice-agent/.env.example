# Database (matches docker-compose.yml defaults)
POSTGRES_USER=viox
POSTGRES_PASSWORD=voiceagent
POSTGRES_DB=banking
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API server
PORT=3000

# GPU box endpoints (Phase 2 — not needed for Phase 1)
# WHISPER_URL=http://<gpu-box-ip>:8001
# OLLAMA_URL=http://<gpu-box-ip>:11434
# OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
# TTS_URL=http://<gpu-box-ip>:8002

# Set to "true" to bypass all GPU calls for local development
MOCK_AI=true

# OTP settings
OTP_EXPIRY_SECONDS=120
OTP_MAX_ATTEMPTS=3

# LiveKit (Phase 5)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=APIxxxxxx
# LIVEKIT_API_SECRET=your-secret

# Backend URL (used by LiveKit agent to call Node.js API)
BACKEND_URL=http://localhost:3000
